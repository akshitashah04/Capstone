# Set only in your hosting provider's secret/environment configuration.
# Do not put this value in browser code, commit it, or use a VITE_ prefix.
GOOGLE_BOOKS_API_KEY=

# Optional live room availability. Obtain read-only access from NYU's LibCal admin.
LIBCAL_CLIENT_ID=
LIBCAL_CLIENT_SECRET=
LIBCAL_INDIVIDUAL_CATEGORY_ID=
LIBCAL_GROUP_CATEGORY_ID=
# Default is the institutional LibCal v1.1 endpoint; confirm with NYU.
LIBCAL_API_BASE=https://nyu.libcal.com/1.1

# Optional generative wording. This is a SEPARATE key/API from Google Books.
# Without it the contextual student-helper workflows remain functional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
